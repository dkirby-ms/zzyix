{
  "name": "zzyix-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nodemon --exec 'node --env-file=../../.env --import tsx/esm --import ./src/telemetry.ts' src/index.ts",
    "build": "tsc",
    "lint": "oxlint",
    "start": "node --import ./dist/telemetry.js dist/index.js",
    "db:apply": "node dist/db/migrate.js",
    "db:backfill:quilts": "node dist/db/quiltBackfill.js",
    "db:parity:quilts": "node dist/db/quiltParityCli.js",
    "db:canonical-world": "node dist/cli/selectCanonicalWorld.js",
    "jobs:principal-deletion": "node dist/jobs/principalDeletionCli.js",
    "operations:principal-recovery": "node dist/operations/principalRecoveryCli.js",
    "telemetry:canonical-retirement": "node dist/operations/canonicalRetirementReportCli.js",
    "db:generate": "npx drizzle-kit@0.31.10 generate",
    "db:migrate": "npx drizzle-kit@0.31.10 migrate",
    "db:rollback": "echo 'Rollback uses authored reverse SQL migrations; no automatic rollback command is configured.'",
    "test": "vitest run --coverage",
    "test:authorization-benchmark": "RUN_AUTHORIZATION_BENCHMARKS=true vitest run src/db/authorization.benchmark.test.ts --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@socket.io/postgres-adapter": "^0.5.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jose": "^6.2.4",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.7",
    "oxlint": "^1.76.0",
    "pg-mem": "^3.0.5",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
