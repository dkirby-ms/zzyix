{
  "name": "zzyix-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:test-auth": "node scripts/dev-test-auth.mjs",
    "db:apply": "npm run build:server && node --env-file=.env apps/server/dist/db/migrate.js",
    "db:backfill:quilts": "npm run build:server && node --env-file=.env apps/server/dist/db/quiltBackfill.js",
    "db:parity:quilts": "npm run build:server && node --env-file=.env apps/server/dist/db/quiltParityCli.js",
    "db:canonical-world": "npm run build:server && node --env-file=.env apps/server/dist/cli/selectCanonicalWorld.js",
    "db:initialize-canonical-world": "npm run build:server && node --env-file=.env apps/server/dist/db/initializeCanonicalWorld.js",
    "jobs:principal-deletion": "npm run build:server && node --env-file=.env apps/server/dist/jobs/principalDeletionCli.js",
    "telemetry:canonical-retirement": "npm run build:server && node apps/server/dist/operations/canonicalRetirementReportCli.js",
    "db:seed": "npm run build:server && node --env-file=.env apps/server/dist/db/seed.js",
    "db:purge": "./scripts/database-purge.sh",
    "audit": "npm audit --omit=dev --audit-level=high --workspaces --include-workspace-root --if-present",
    "audit:full": "npm audit --audit-level=high --workspaces --include-workspace-root --if-present",
    "audit:client": "npm audit --audit-level=high --workspace=apps/client",
    "audit:server": "npm audit --audit-level=high --workspace=apps/server",
    "build": "npm run build --workspaces --if-present",
    "build:client": "npm run build --workspace=apps/client",
    "build:server": "npm run build --workspace=apps/server",
    "lint": "npm run lint --workspaces --if-present",
    "lint:client": "npm run lint --workspace=apps/client",
    "lint:server": "npm run lint --workspace=apps/server",
    "lint:commits": "commitlint --from HEAD~20 --to HEAD --verbose",
    "test": "npm run test --workspaces --if-present",
    "test:release-contract": "node --test scripts/release-contract.test.mjs",
    "test:client": "npm run test --workspace=apps/client",
    "test:server": "npm run test --workspace=apps/server",
    "test:authorization-benchmark": "npm run test:authorization-benchmark --workspace=apps/server",
    "test:e2e": "npm run test:e2e:install && npm run test:e2e:preflight && playwright test",
    "test:e2e:headed": "npm run test:e2e:install && npm run test:e2e:preflight && playwright test --headed",
    "test:e2e:ui": "npm run test:e2e:install && npm run test:e2e:preflight && playwright test --ui",
    "test:e2e:ci": "npm run test:e2e:install && npm run test:e2e:preflight && playwright test --reporter=line",
    "test:e2e:owner-only": "npm run test:e2e:install && npm run test:e2e:preflight && playwright test e2e/authentication.spec.ts e2e/quilt-seams.spec.ts e2e/smoke.spec.ts --reporter=line",
    "test:e2e:multi-replica": "npm run test:e2e:install && npm run test:e2e:preflight && playwright test --config=playwright.multi-replica.config.ts e2e/quilt-reconnect.spec.ts --reporter=line",
    "test:e2e:delegated": "node -e \"console.error('Delegated and moderator acceptance remains deferred and must not be treated as complete.'); process.exit(1)\"",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:preflight": "node ./scripts/verify-playwright-linux-deps.mjs",
    "test:watch:client": "npm run test:watch --workspace=apps/client",
    "test:watch:server": "npm run test:watch --workspace=apps/server",
    "release": "semantic-release --extends ./.releaserc.cjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "semantic-release": "^25.0.9"
  }
}
