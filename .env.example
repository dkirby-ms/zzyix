# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zzyix
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379


# apps/server configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zzyix

# apps/server authentication configuration
# Replace <tenant-id> and API values with the environment's Entra app registration values.
AUTH_ACCEPTED_ALGORITHM=RS256
AUTH_TRUSTED_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_API_AUDIENCE=api://zzyix
AUTH_REQUIRED_SCOPE=quilt.access
AUTH_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

# apps/server agent authentication configuration
# AUTH_AGENT_TRUSTED_ISSUER can match AUTH_TRUSTED_ISSUER for same-tenant worker auth.
AUTH_AGENT_TRUSTED_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_AGENT_API_AUDIENCE=api://zzyix-agent-reader
AUTH_AGENT_REQUIRED_ROLE=agent.runtime
FEATURE_AGENT_READS_ENABLED=false

# apps/agent-worker configuration
# Local development can use the same database URL after migrations create the agent_control schema.
# Shared and deployed environments must use a restricted login role with access only to agent_control.
AGENT_CONTROL_PLANE_DSN=postgresql://postgres:postgres@localhost:5432/zzyix
AGENT_SERVER_BASE_URL=http://127.0.0.1:3001
AGENT_SERVER_TOKEN_SCOPE=api://zzyix-agent-reader/.default
AGENT_PRINCIPAL_ID=11111111-1111-4111-8111-111111111111
AGENT_FEATURE_MODEL_FREE_ENABLED=true
AGENT_FEATURE_FOUNDRY_ENABLED=false
AGENT_FEATURE_STRUCTURED_PROPOSALS_ENABLED=false
AGENT_GATEWAY_MODE=fake
AGENT_LEASE_TTL_SECONDS=20
AGENT_POLL_INTERVAL_SECONDS=1
AGENT_TOOL_TIMEOUT_SECONDS=5

# Optional telemetry configuration
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SAMPLING_RATIO=1.0

