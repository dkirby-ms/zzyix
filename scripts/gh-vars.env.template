# Fill in values, then run:
#   ./scripts/bootstrap-cd-environment.sh --repo dkirby-ms/zzyix --environment staging

# Azure infra deployment
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000001
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000002
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000003
AZURE_RESOURCE_GROUP=rg-zzyix-staging
AZURE_CONTAINERAPPS_ENVIRONMENT=zzyix-staging-aca-env
AZURE_LOCATION=eastus
SERVER_CONTAINER_APP_NAME=zzyix-staging-server
CLIENT_CONTAINER_APP_NAME=zzyix-staging-client
AGENT_WORKER_CONTAINER_APP_NAME=zzyix-staging-agent-worker
MIGRATION_JOB_NAME=zzyix-staging-migrations
CANONICAL_INITIALIZATION_JOB_NAME=zzyix-staging-canon-init
SERVER_CORS_ORIGIN=https://app.zzyix.example.com

# Microsoft Entra External ID public client configuration
AUTH_AUTHORITY=https://contoso.ciamlogin.com/contoso.onmicrosoft.com
AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000004
AUTH_API_SCOPE=api://00000000-0000-0000-0000-000000000005/access_as_user
AUTH_API_ORIGIN=https://app.zzyix.example.com
AUTH_REDIRECT_URI=https://app.zzyix.example.com
AUTH_POST_LOGOUT_REDIRECT_URI=https://app.zzyix.example.com

# Microsoft Entra External ID server token validation
AUTH_TRUSTED_ISSUER=https://contoso.ciamlogin.com/00000000-0000-0000-0000-000000000006/v2.0
AUTH_API_AUDIENCE=00000000-0000-0000-0000-000000000005
AUTH_REQUIRED_SCOPE=access_as_user
AUTH_JWKS_URI=https://contoso.ciamlogin.com/contoso.onmicrosoft.com/discovery/v2.0/keys
AUTH_ACCEPTED_ALGORITHM=RS256

# Fantome agent app-only API configuration. Same-tenant agent auth can reuse AUTH_TRUSTED_ISSUER.
AUTH_AGENT_TRUSTED_ISSUER=https://contoso.ciamlogin.com/00000000-0000-0000-0000-000000000006/v2.0
AUTH_AGENT_API_AUDIENCE=api://zzyix-agent-reader
AUTH_AGENT_REQUIRED_ROLE=agent.runtime
AGENT_SERVER_TOKEN_SCOPE=api://zzyix-agent-reader/.default
AGENT_PRINCIPAL_ID=11111111-1111-4111-8111-111111111111

# Fantome agent rollout gates and operational defaults
FEATURE_AGENT_READS_ENABLED=false
AGENT_FEATURE_MODEL_FREE_ENABLED=true
AGENT_FEATURE_FOUNDRY_ENABLED=false
AGENT_FEATURE_STRUCTURED_PROPOSALS_ENABLED=false
AGENT_GATEWAY_MODE=fake
AGENT_WORKER_MIN_REPLICAS=1
AGENT_WORKER_MAX_REPLICAS=2
AGENT_LEASE_TTL_SECONDS=20
AGENT_POLL_INTERVAL_SECONDS=1
AGENT_TOOL_TIMEOUT_SECONDS=5

# Required: Application Insights connection string from infra deployment output.
# Example lookup:
# az deployment group show \
#   --resource-group <resource-group> \
#   --name <infra-deployment-name> \
#   --query properties.outputs.appInsightsConnectionString.value \
#   --output tsv
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=5ba593dc-75a0-4811-a592-e973e82d97bf;IngestionEndpoint=https://westus3-1.in.applicationinsights.azure.com/;LiveEndpoint=https://westus3.livediagnostics.monitor.azure.com/;ApplicationId=4b69c3c3-98c1-42f1-b52b-ee67cf27a8ac

# Optional observability tuning
# OTEL_SAMPLING_RATIO=1.0

# Example (Azure PostgreSQL Flexible Server):
# SERVER_DATABASE_URL=postgresql://<adminLogin>:<password>@<server>.postgres.database.azure.com:5432/zzyix?sslmode=verify-full
SERVER_DATABASE_URL=postgresql://zzyix_admin:<password>@zzyix-staging.postgres.database.azure.com:5432/zzyix

# Required: restricted PostgreSQL login for the Fantome worker control plane.
# This role must be limited to the agent_control schema in shared environments.
AGENT_CONTROL_PLANE_DSN=postgresql://agent_control_worker:<password>@zzyix-staging.postgres.database.azure.com:5432/zzyix?sslmode=verify-full

# Optional (for private GHCR pulls)
AZURE_GHCR_USERNAME=<github-username>
AZURE_GHCR_PASSWORD=<github-token>
